{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4327 node scripts/serve.js dist",
      "startServerReadyPattern": "Static server running",
      "url": [
        "http://127.0.0.1:4327/retardo_cne/",
        "http://127.0.0.1:4327/retardo_cne/en/",
        "http://127.0.0.1:4327/retardo_cne/metodologia/",
        "http://127.0.0.1:4327/retardo_cne/en/metodologia/"
      ],
      "settings": { "chromeFlags": "--no-sandbox" },
      "budgetPath": ".lighthouse/budget.json"
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "interaction-to-next-paint": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
