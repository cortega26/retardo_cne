---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import expertClaimManifest from '../data/expert-claims.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const locale = lang === 'es' ? 'es' : 'en';
const experts = expertClaimManifest.claims.map((claim) => ({
  name: claim.name,
  affiliation: claim.affiliation[locale],
  finding: claim.finding[locale],
  method: claim.method[locale],
  caveat: claim.caveat[locale],
  url: claim.source.url,
  date: claim.date[locale],
}));
---

<!-- Not rendered directly by pages. Kept aligned with the reviewed claim manifest. -->
<section id="analisis-tecnico" class="story-section w-full my-12" aria-label={t('nav_evidence_analysis')}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="section-label">{t('badge_analysis')}</span>
      <h2 class="uppercase font-bold mb-6">{t('analysis_title')}</h2>
      <p class="story-subtitle">
        {lang === 'es'
          ? 'Los análisis enlazados se refieren a dos conjuntos de datos distintos; cada tarjeta identifica su alcance y salvedad.'
          : 'The linked analyses concern two distinct datasets; each card identifies its scope and caveat.'}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {experts.map((expert) => (
        <div>
          <div class="story-card h-full flex flex-col">
            <div class="flex items-start justify-between gap-3 mb-6">
              <div>
                <p class="story-kicker mb-1">{expert.date}</p>
                <h3 class="text-base font-semibold mb-0">{expert.name}</h3>
                <p class="text-sm text-gray-500 mb-0">{expert.affiliation}</p>
              </div>
              <span class="status-tag status-tag-failed shrink-0">
                {lang === 'es' ? 'Hallazgo' : 'Finding'}
              </span>
            </div>

            <p class="text-sm mb-6 flex-1" style="color: var(--text-secondary); line-height: 1.65; font-style: italic;">
              "{expert.finding}"
            </p>

            <div class="mb-3">
              <span class="story-kicker mb-0" style="display: inline;">{lang === 'es' ? 'Método:' : 'Method:'}</span>
              <span class="text-sm text-gray-500"> {expert.method}</span>
            </div>
            <p class="text-sm mb-6" style="color: var(--text-secondary);">{expert.caveat}</p>

            <div class="mt-auto pt-3" style="border-top: 1px solid var(--border-subtle);">
              <a href={expert.url} target="_blank" rel="noopener noreferrer" class="story-link font-bold">
                {lang === 'es' ? 'Ver análisis completo' : 'Read full analysis'} →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
