---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Counter from './Counter.astro';
import { ELECTION_TIMELINE } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Election: 28 July 2024 at 06:00 AM VET (UTC-4)
// Art. 146 LOPRE: 48 hours → 30 July 2024 06:00 AM VET
// Art. 155 LOPRE: 30 days  → 27 August 2024 06:00 AM VET

const deadline48hLabel = lang === 'es' ? '48 horas desde el 28J' : '48 hours from July 28';
const deadline30dLabel = lang === 'es' ? '30 días desde el 28J'  : '30 days from July 28';
---

<section class="story-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-12" id="plazos" aria-label={t('nav_context_deadlines')}>
  <div class="text-center mb-8">
    <h3 class="uppercase font-bold">{t('badge_deadlines')}</h3>
    <p class="story-subtitle">{t('status_subtitle')}</p>
  </div>
</section>

<section id="main-content">
  <Counter
    id="counter1"
    targetDate={ELECTION_TIMELINE.totalizationDeadlineAt}
    electionDate={ELECTION_TIMELINE.electionAt}
    deadlineLabel={deadline48hLabel}
    title={t('status_card_1_title')}
    violationText={t('status_violation_overdue')}
    legalRef={t('status_card_1_rule')}
    progressLegal={ELECTION_TIMELINE.totalizationProgressPercent}
  />
  <Counter
    id="counter2"
    targetDate={ELECTION_TIMELINE.gazetteDeadlineAt}
    electionDate={ELECTION_TIMELINE.electionAt}
    deadlineLabel={deadline30dLabel}
    title={t('status_card_2_title')}
    violationText={t('status_violation_failed')}
    legalRef={t('status_card_2_rule')}
    progressLegal={ELECTION_TIMELINE.gazetteProgressPercent}
  />
</section>
