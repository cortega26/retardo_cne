---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { EXTERNAL_LINKS } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeHref = base + (es ? '/' : '/en/');
const langHref = base + (es ? '/en/' : '/');
const groups = [
  { id: 'evidence', href: '#cronologia', label: t('nav_evidence'), items: [
    ['#actas', es ? 'Actas disponibles' : 'Available tally sheets'],
    ['#procedencia', es ? 'Origen y autenticidad' : 'Origin and authenticity'],
    ['#analisis-tecnico', es ? 'Análisis de datos' : 'Data analysis'],
    ['#cronologia', t('nav_evidence_timeline')],
    ['#auditorias', t('nav_evidence_audits')],
  ] },
  { id: 'context', href: '#sistema', label: t('nav_context'), items: [
    ['#obligacion', es ? 'Obligaciones legales' : 'Legal obligations'],
    ['#sistema', t('nav_context_system')],
    ['#internacional', es ? 'Observadores' : 'Observers'],
    ['#antecedentes', t('nav_context_background_section')],
    ['#estado-actual', t('nav_context_post')],
  ] },
  { id: 'verification', href: '#verificacion', label: t('nav_verification'), items: [
    ['#procedencia', es ? 'Cómo se autentican las actas' : 'How tally sheets are authenticated'],
    ['#analisis-tecnico', es ? 'Contraste numérico' : 'Numerical cross-check'],
    ['#verificacion', t('nav_verification_section')],
    [base + (es ? '/metodologia' : '/en/metodologia'), es ? 'Metodología y fuentes' : 'Methods and sources'],
  ] },
];
---
<nav class="navbar navbar-expand-lg site-navbar" aria-label={es ? 'Navegación principal' : 'Main navigation'}>
  <div class="container-fluid site-navbar__inner">
    <a class="navbar-brand site-navbar__identity" href={homeHref} aria-label={es ? 'Retardo CNE, inicio' : 'Retardo CNE, home'}>
      <span class="site-navbar__monogram" aria-hidden="true">28<span>J</span></span>
      <span class="site-navbar__wordmark"><strong>Retardo CNE</strong><small>{es ? 'Observatorio electoral' : 'Electoral observatory'}</small></span>
    </a>
    <div class="collapse navbar-collapse site-navbar__menu" id="navbarNav">
      <ul class="navbar-nav site-navbar__links">
        {groups.map(group => (
          <li class="nav-item dropdown nav-item-split site-navbar__group">
            <a class="nav-link nav-link-primary site-navbar__primary" href={group.href}>{group.label}</a>
            <button class="nav-link dropdown-toggle dropdown-toggle-split nav-link-toggle site-navbar__chevron" type="button" id={group.id + 'Dropdown'} data-toggle="dropdown" aria-controls={group.id + 'Menu'} aria-haspopup="true" aria-expanded="false" aria-label={group.label + (es ? ' submenú' : ' submenu')}>
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
            </button>
            <ul class="dropdown-menu site-navbar__dropdown" id={group.id + 'Menu'} aria-labelledby={group.id + 'Dropdown'}>
              <li class="site-navbar__dropdown-heading" aria-hidden="true">{group.label}</li>
              {group.items.map(item => <li><a class="dropdown-item site-navbar__dropdown-link" href={item[0]}>{item[1]}<span aria-hidden="true">↗</span></a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
    <div class="nav-controls site-navbar__controls">
      <a id="toggleLang" class="site-navbar__utility site-navbar__lang" href={langHref} data-target-lang={es ? 'en' : 'es'} aria-label={es ? 'Cambiar el idioma a inglés' : 'Change language to Spanish'}><span class="lang-code">{es ? 'EN' : 'ES'}</span></a>
      <button id="toggleTheme" class="site-navbar__utility site-navbar__theme" type="button" aria-label={t('nav_toggle_theme')} title={t('nav_toggle_theme')} aria-pressed="false">
        <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="17" height="17" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" width="17" height="17" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 15.8A8.5 8.5 0 0 1 8.2 4 8.5 8.5 0 1 0 20 15.8Z"/></svg>
      </button>
      <a class="site-navbar__source" href={EXTERNAL_LINKS.resultadosConVzla} target="_blank" rel="noopener noreferrer">{es ? 'Consultar actas' : 'Browse tally sheets'}<span aria-hidden="true">↗</span></a>
    </div>
    <button class="navbar-toggler custom-toggler site-navbar__toggler" type="button" data-toggle="navbar-collapse" aria-controls="navbarNav" aria-expanded="false" aria-label={es ? 'Abrir navegación' : 'Open navigation'}><span class="toggler-icon"></span><span class="toggler-icon"></span></button>
  </div>
</nav>
<style>
.site-navbar {
  --nav-ink:#273941; --nav-muted:#5a6c73; --nav-line:#d7deda;
  --nav-surface:#fafaf7; --nav-hover:#edf0ec; --nav-accent:#8b6446;
  position:sticky;top:0;z-index:1000;min-height:76px;background:var(--nav-surface);
  border:0;border-bottom:1px solid var(--nav-line);box-shadow:none;backdrop-filter:none;-webkit-backdrop-filter:none;
}
:global([data-theme="dark"]) .site-navbar {
  --nav-ink:#ecefeb;--nav-muted:#b3bfc1;--nav-line:#3b4850;
  --nav-surface:#1a252b;--nav-hover:#28363d;--nav-accent:#d6bb98;
}
.site-navbar .site-navbar__inner {width:min(1240px,100%);margin:auto;padding:.75rem clamp(1rem,2.5vw,2rem);gap:clamp(.8rem,1.7vw,1.8rem);flex-wrap:nowrap;min-width:0;}
.site-navbar__identity {display:inline-flex;align-items:center;flex:0 0 auto;gap:.8rem;text-transform:none;letter-spacing:normal;font-size:1rem;color:var(--nav-ink);text-decoration:none;}
.site-navbar__identity:hover{color:var(--nav-ink);}
.site-navbar__monogram{width:44px;height:44px;display:inline-flex;align-items:center;justify-content:center;flex:none;border:1px solid var(--nav-ink);font:800 1.05rem/1 var(--font-display,sans-serif);letter-spacing:-.08em;color:var(--nav-ink);}
.site-navbar__monogram span{color:var(--nav-accent);}
.site-navbar__wordmark{display:grid;gap:.14rem;}
.site-navbar__wordmark strong{color:var(--nav-ink);font:750 1.04rem/1.12 var(--font-display,sans-serif);letter-spacing:-.038em;white-space:nowrap;}
.site-navbar__wordmark small{color:var(--nav-muted);font:600 .67rem/1.25 var(--font-sans,sans-serif);letter-spacing:.04em;white-space:nowrap;}
.site-navbar .site-navbar__menu{flex:1 1 auto;min-width:0;margin:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;}
.site-navbar .site-navbar__links{display:flex;flex-direction:row;align-items:center;gap:.1rem;padding:0;margin:0 auto;list-style:none;}
.site-navbar__group{display:inline-flex;align-items:center;position:relative;border-radius:2px;transition:background-color .15s;}
.site-navbar__group:hover,.site-navbar__group.show{background:var(--nav-hover);}
.site-navbar .site-navbar__primary,.site-navbar .site-navbar__chevron{color:var(--nav-ink)!important;opacity:1;border-radius:0;text-transform:none;font-size:.89rem!important;letter-spacing:.005em!important;line-height:1.3;font-weight:600;}
.site-navbar .site-navbar__primary{padding:.7rem .15rem .7rem .85rem!important;white-space:nowrap;}
.site-navbar .site-navbar__chevron{appearance:none;min-width:32px;min-height:44px;padding:0 .55rem 0 .2rem!important;display:inline-grid;place-items:center;cursor:pointer;border:0;background:transparent;}
.site-navbar__chevron svg{transition:transform .16s;}
.site-navbar__group.show .site-navbar__chevron svg{transform:rotate(180deg);}
.site-navbar .site-navbar__primary:hover,.site-navbar .site-navbar__chevron:hover,.site-navbar .site-navbar__primary:focus-visible,.site-navbar .site-navbar__chevron:focus-visible{color:var(--nav-accent)!important;}
.site-navbar .site-navbar__dropdown{left:0;top:calc(100% + .8rem);width:min(19rem,calc(100vw - 2rem));min-width:min(18rem,calc(100vw - 2rem));border:1px solid var(--nav-line);border-radius:4px;padding:.75rem .5rem .5rem;background:var(--nav-surface);box-shadow:0 20px 45px -26px #101c2b48;animation:none;list-style:none;}
.site-navbar .site-navbar__dropdown-heading{padding:.2rem .75rem .7rem;margin-bottom:.3rem;border-bottom:1px solid var(--nav-line);color:var(--nav-muted);text-transform:uppercase;font:700 .61rem/1.4 var(--font-mono,monospace);letter-spacing:.1em;}
.site-navbar .site-navbar__dropdown-link{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem .75rem;white-space:normal;border-radius:2px;font-size:.87rem;font-weight:600;color:var(--nav-ink);line-height:1.4;}
.site-navbar__dropdown-link span{color:var(--nav-muted);}
.site-navbar .site-navbar__dropdown-link:hover,.site-navbar .site-navbar__dropdown-link:focus-visible{color:var(--nav-ink);background:var(--nav-hover);transform:none;}
.site-navbar__controls{display:inline-flex;flex:0 0 auto;align-items:center;gap:.2rem;margin:0;}
.site-navbar__utility{width:40px;height:44px;padding:0;display:inline-grid;place-items:center;border:0;border-radius:2px;color:var(--nav-muted);background:transparent;font:750 .72rem/1 var(--font-sans,sans-serif);letter-spacing:.04em;text-decoration:none;cursor:pointer;}
.site-navbar__utility:hover,.site-navbar__utility:focus-visible{color:var(--nav-ink);background:var(--nav-hover);}
.site-navbar__theme .icon{display:block;}
:global(body:not(.dark-mode)) .site-navbar__theme .icon-sun,:global(body.dark-mode) .site-navbar__theme .icon-moon{display:none;}
.site-navbar__source{display:inline-flex;align-items:center;gap:.7rem;min-height:42px;padding:.55rem .85rem;margin-left:.35rem;white-space:nowrap;border:1px solid var(--nav-ink);border-radius:2px;color:var(--nav-ink);font-size:.78rem;font-weight:750;text-decoration:none;transition:background-color .15s,color .15s;}
.site-navbar__source span{color:var(--nav-accent);}
.site-navbar__source:hover{color:var(--nav-surface);background:var(--nav-ink);}
.site-navbar__source:hover span{color:var(--nav-surface);}
.site-navbar .site-navbar__toggler{width:44px;height:44px;flex:none;align-items:center;justify-content:center;border:1px solid var(--nav-line);border-radius:2px;background:transparent;padding:.5rem;gap:5px;margin-left:.25rem;cursor:pointer;}
.site-navbar__toggler .toggler-icon{height:1.5px;width:20px;border-radius:0;background:var(--nav-ink);}
.site-navbar__toggler .toggler-icon:last-child{width:14px;}
.site-navbar__toggler[aria-expanded="true"] .toggler-icon:last-child{width:20px;}
.site-navbar__toggler:hover{background:var(--nav-hover);}
@media(min-width:992px){.site-navbar .site-navbar__menu{display:flex!important;justify-content:center;}.site-navbar .site-navbar__toggler{display:none;}}
@media(max-width:991.98px){
 .site-navbar .site-navbar__inner{flex-wrap:wrap;gap:.4rem;}
 .site-navbar__identity{margin-right:auto;}.site-navbar__controls{margin-left:auto;}
 .site-navbar__source{display:none;}
 .site-navbar .site-navbar__toggler{display:flex;flex-direction:column;}
 .site-navbar .site-navbar__menu{order:4;flex-basis:100%;width:100%;margin:.4rem 0 0;padding:.6rem 0 .3rem;max-height:calc(100dvh - 94px);overflow-y:auto;border-top:1px solid var(--nav-line);}
 .site-navbar .site-navbar__menu:not(.show){display:none;}.site-navbar .site-navbar__menu.show{display:block;}
 .site-navbar .site-navbar__links{width:100%;flex-direction:column;align-items:stretch;gap:.15rem;}
 .site-navbar__group{display:grid;grid-template-columns:minmax(0,1fr) 44px;width:100%;align-items:start;}
 .site-navbar .site-navbar__primary{padding:.82rem .85rem!important;}
 .site-navbar .site-navbar__chevron{width:44px;padding:.4rem!important;}
 .site-navbar .site-navbar__dropdown{position:static;grid-column:1/-1;width:100%;min-width:0;margin:.1rem 0 .6rem;padding:.35rem;box-shadow:none;background:var(--nav-hover);border:0;border-left:2px solid var(--nav-accent);}
 .site-navbar .site-navbar__dropdown-link:hover{background:var(--nav-surface);}
}
@media(max-width:430px){.site-navbar__wordmark small{font-size:.62rem;letter-spacing:0}.site-navbar__monogram{width:38px;height:38px}.site-navbar__identity{gap:.55rem}.site-navbar__utility{width:34px}.site-navbar .site-navbar__inner{padding-inline:.85rem}}
@media(prefers-reduced-motion:reduce){.site-navbar__group,.site-navbar__source,.site-navbar__chevron svg{transition:none}}
@media print{.site-navbar{display:none}}
</style>
