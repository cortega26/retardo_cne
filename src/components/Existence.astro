---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { EXTERNAL_LINKS } from '../data/site';
import expertClaimManifest from '../data/expert-claims.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const es = lang === 'es';
const locale = es ? 'es' : 'en';
const kronick = expertClaimManifest.claims.find((claim) => claim.id === 'kronick-opposition-actas');

const copy = {
  badge:       es ? 'Acto II — Lo que sí existe'   : 'Act II — What does exist',
  title:       es ? 'Los documentos que sí se pueden examinar' : 'The documents that can be examined',
  opening:     es
    ? 'Las máquinas del CNE emiten las actas de escrutinio. Testigos opositores recopilaron y publicaron 25.575 imágenes para un total de 30.026 mesas (corte del 3 de enero de 2025). Los documentos pueden examinarse por mesa, aunque el CNE no publicó su propio desglose.'
    : 'CNE machines produce the election tally sheets. Opposition poll watchers collected and published 25,575 images out of 30,026 polling stations (January 3, 2025 snapshot). The documents can be examined by station, although the CNE did not publish its own breakdown.',
  statLabel1:  es ? 'Actas digitalizadas'           : 'Digitized actas',
  statSub1:    t('verified_minutes_sub'),
  statLabel2:  es ? 'Actas de la colección'         : 'Tally sheets in the collection',
  statSub2:    es ? 'Corte del 3 de enero de 2025'  : 'January 3, 2025 snapshot',
  statLabel3:  es ? 'Mesas previstas'               : 'Total polling stations',
  statSub3:    es ? 'Universo de comparación'       : 'Comparison denominator',
  valTitle:    es ? 'Evaluación académica del material' : 'Academic assessment of the materials',
  valSub:      es ? 'El Centro Carter también examinó una muestra de actas y sus elementos de seguridad. Ambas evaluaciones deben leerse según sus métodos y alcances.'
                  : 'The Carter Center also reviewed a sample of tally sheets and their security features. Both assessments must be read within their methods and scope.',
  readPaper:   es ? 'Ver paper completo →'          : 'Read full paper →',
  ctaTitle:    es ? 'Consulta las actas'            : 'Check the actas',
  ctaText:     es
    ? 'Puedes revisar acta por acta, mesa por mesa, con su respaldo fotográfico y código QR.'
    : 'You can review each acta, polling station by polling station, with photographic backup and QR code.',
  ctaBtn:      es ? 'Ir a ResultadosConVzla'        : 'Go to ResultadosConVzla',
  ctaBtn2:     es ? 'Ver MacedoniaDelNorte'         : 'View MacedoniaDelNorte',
};
---

<section id="actas" class="existence-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 my-14">

  <div class="existence-header">
    <span class="section-label">{copy.badge}</span>
    <h2 class="existence-title">{copy.title}</h2>
    <p class="existence-opening">{copy.opening}</p>
  </div>

  <!-- Stats row -->
  <div class="existence-stats">
    <div class="story-card text-center">
      <p class="existence-stat-value">85,18%</p>
      <p class="existence-stat-label">{copy.statLabel1}</p>
      <p class="existence-stat-sub">{copy.statSub1}</p>
    </div>
    <div class="story-card text-center">
      <p class="existence-stat-value">{es ? '25.575' : '25,575'}</p>
      <p class="existence-stat-label">{copy.statLabel2}</p>
      <p class="existence-stat-sub">{copy.statSub2}</p>
    </div>
    <div class="story-card text-center">
      <p class="existence-stat-value">{es ? '30.026' : '30,026'}</p>
      <p class="existence-stat-label">{copy.statLabel3}</p>
      <p class="existence-stat-sub">{copy.statSub3}</p>
    </div>
  </div>
  <div class="existence-source-band" role="note">
    <span>{es ? 'Origen de las cifras: ResultadosConVzla (corte de 2025). Revisión independiente de una muestra anterior: Centro Carter, informe de 2025.' : 'Figures: ResultadosConVzla (2025 snapshot). Independent review of an earlier sample: Carter Center, 2025 report.'}</span>
    <a href="https://www.cartercenter.org/publication/final-report-observation-of-the-2024-presidential-election-in-venezuela/" target="_blank" rel="noopener noreferrer">{es ? 'Leer evaluación' : 'Read assessment'} ↗</a>
  </div>

  <!-- Academic validation card -->
  <div class="existence-validation">
    <div class="existence-validation__body">
      <p class="existence-validation__label">{copy.valTitle}</p>
      <div class="existence-validation__expert">
        <div>
          <p class="existence-expert-name">{kronick?.name}</p>
          <p class="existence-expert-affil">{kronick?.affiliation[locale]}</p>
        </div>
        <span class="existence-expert-tag">{es ? 'Hallazgo' : 'Finding'}</span>
      </div>
      <blockquote class="existence-finding">"{kronick?.finding[locale]}"</blockquote>
      <p class="existence-method">
        <strong>{es ? 'Método:' : 'Method:'}</strong> {kronick?.method[locale]}
      </p>
      <p class="existence-validation__note">{kronick?.caveat[locale]}</p>
      <a class="story-link" href={kronick?.source.url} target="_blank" rel="noopener noreferrer">
        {copy.readPaper}
      </a>
    </div>
    <p class="existence-validation__note">{copy.valSub}</p>
  </div>

  <!-- CTA row -->
  <div class="existence-cta story-card">
    <div class="existence-cta__copy">
      <h3 class="existence-cta__title">{copy.ctaTitle}</h3>
      <p class="existence-cta__text">{copy.ctaText}</p>
    </div>
    <div class="existence-cta__actions">
      <a class="btn btn-primary" href={EXTERNAL_LINKS.resultadosConVzla} target="_blank" rel="noopener noreferrer">
        {copy.ctaBtn}
      </a>
      <a class="btn btn-outline-primary" href="https://macedoniadelnorte.com/" target="_blank" rel="noopener noreferrer">
        {copy.ctaBtn2}
      </a>
    </div>
  </div>

</section>

<style>
  .existence-source-band { display: flex; gap: .85rem 1.4rem; flex-wrap: wrap; justify-content: space-between; align-items: baseline; padding: .9rem 1.2rem; border: 1px solid var(--border-subtle); border-top: none; background: var(--bg-card); font-size: .8rem; line-height: 1.6; color: var(--text-secondary); }
  .existence-source-band span { flex: 1 1 24rem; }
  .existence-source-band a { color: var(--text-accent); font-weight: 700; text-underline-offset: .16em; }
</style>
