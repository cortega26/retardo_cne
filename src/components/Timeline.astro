---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const milestones = [
  { date: `28 ${t('month_jul')} 2024`,  event: t('timeline_event_1'), status: t('status_normal'),    type: 'met'    },
  { date: `28 ${t('month_jul')} @ 22h`, event: t('timeline_event_2'), status: t('status_violation'), type: 'failed' },
  { date: `29 ${t('month_jul')} @ 00h`, event: t('timeline_event_3'), status: t('status_violation'), type: 'failed' },
  { date: `29-31 ${t('month_jul')}`,    event: t('timeline_event_4'), status: t('status_violation'), type: 'failed' },
  { date: `30 ${t('month_jul')} 2024`,  event: t('timeline_event_5'), status: t('status_overdue'),   type: 'failed' },
  { date: `02 ${t('month_aug')} 2024`,  event: t('timeline_event_6'), status: t('status_violation'), type: 'failed' },
  // Art. 155 LOPRE: 30 days from July 28 = August 27
  { date: `27 ${t('month_aug')} 2024`,  event: t('timeline_event_7'), status: t('status_overdue'),   type: 'failed' },
  { date: `10 ${t('month_jan')} 2025`,  event: t('timeline_event_8'), status: t('status_overdue'),   type: 'failed' }
];
---

<section class="timeline-section w-full my-12" id="cronologia" aria-label={t('nav_evidence_timeline')}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-12">
    <span class="section-label">{t('badge_timeline')}</span>
    <h2 class="uppercase font-bold mb-6">{t('nav_evidence_timeline')}</h2>
    <p class="story-subtitle">{t('timeline_subtitle')}</p>
  </div>

  <ol class="timeline">
    {milestones.map((m, i) => (
      <li class={`timeline-item ${i % 2 === 0 ? 'left' : 'right'} timeline-item--${m.type}`}>
        <div class="content shadow-sm">
          <span class="date">{m.date}</span>
          <h3>{m.event}</h3>
          <p>
            <span class={`status-tag ${m.type === 'met' ? 'status-tag-met' : 'status-tag-failed'}`}>
              {m.status}
            </span>
          </p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Riel cronológico: eje central en escritorio, eje a la izquierda en móvil. */
  .timeline {
    position: relative;
    list-style: none;
  }

  /* Eje vertical continuo. */
  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 11px;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--border-subtle) 8%,
      var(--border-subtle) 92%,
      transparent
    );
  }

  .timeline-item {
    position: relative;
    padding-left: 2.75rem;
  }

  .timeline-item + .timeline-item {
    margin-top: 1rem;
  }

  /* Nodo sobre el eje. */
  .timeline-item::before {
    content: "";
    position: absolute;
    top: 1.4rem;
    left: 6px;
    z-index: 1;
    width: 12px;
    height: 12px;
    border: 2px solid var(--bg-body);
    border-radius: 999px;
    background: var(--text-secondary);
  }

  .timeline-item--failed::before {
    background: var(--color-breach-600);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-breach-600) 16%, transparent);
  }

  .timeline-item--met::before {
    background: var(--color-lawful-500);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-lawful-500) 16%, transparent);
  }

  /* Conector corto entre el eje y la tarjeta. */
  .timeline-item::after {
    content: "";
    position: absolute;
    top: calc(1.4rem + 5px);
    left: 18px;
    width: 1.1rem;
    height: 2px;
    background: var(--border-subtle);
  }

  .timeline-item .content {
    padding: 1rem 1.15rem;
  }

  .timeline-item .date {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .timeline-item h3 {
    margin: 0 0 0.6rem;
    font-size: 1.02rem;
    line-height: 1.35;
  }

  .timeline-item p {
    margin: 0;
  }

  /* Escritorio: eje centrado con tarjetas alternadas a cada lado. */
  @media (min-width: 900px) {
    .timeline::before {
      left: 50%;
      transform: translateX(-50%);
    }

    .timeline-item {
      width: 50%;
      padding-left: 0;
    }

    .timeline-item + .timeline-item {
      margin-top: 0.5rem;
    }

    .timeline-item.left {
      padding-right: 2.75rem;
    }

    .timeline-item.right {
      margin-left: 50%;
      padding-left: 2.75rem;
    }

    .timeline-item::before {
      left: auto;
    }

    .timeline-item.left::before {
      right: -6px;
    }

    .timeline-item.right::before {
      left: -6px;
    }

    .timeline-item.left::after {
      left: auto;
      right: 6px;
      width: 1.6rem;
    }

    .timeline-item.right::after {
      left: 6px;
      width: 1.6rem;
    }
  }

  @media print {
    .timeline-item {
      width: 100% !important;
      margin-left: 0 !important;
    }
  }
</style>
