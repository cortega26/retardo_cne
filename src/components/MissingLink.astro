---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';

const copy = {
  kicker: es ? 'ACTO IV / CONTRASTE INDEPENDIENTE' : 'ACT IV / INDEPENDENT SCRUTINY',
  title: es ? 'Qué pudieron verificar los observadores' : 'What independent observers could verify',
  opening: es
    ? 'El punto decisivo no depende de un eslogan. Distintos observadores examinaron el proceso y señalaron el mismo déficit documental: el CNE no publicó los resultados detallados por mesa que permitirían comprobar su anuncio.'
    : 'The decisive issue is documentary, not rhetorical. Independent observers examined the process and identified the same evidence gap: the CNE did not publish the station-level results needed to check its announcement.',
  carterTitle: es ? 'Centro Carter' : 'The Carter Center',
  carterType: es ? 'Misión de observación · 30 jul 2024' : 'Observation mission · Jul 30, 2024',
  carterFinding: es
    ? 'Declaró que no podía verificar ni corroborar el resultado anunciado por el CNE debido a la ausencia de resultados desagregados por mesa.'
    : 'Stated that it could not verify or corroborate the result announced by the CNE because polling-station results had not been released.',
  unTitle: es ? 'Panel de Expertos de la ONU' : 'UN Panel of Experts',
  unType: es ? 'Informe provisional · 9 ago 2024' : 'Interim report · Aug 9, 2024',
  unFinding: es
    ? 'Documentó que la gestión de resultados no satisfizo medidas básicas de transparencia e integridad ni los plazos del procedimiento.'
    : 'Found that results management did not meet basic transparency and integrity measures or prescribed procedural deadlines.',
  reviewTitle: es ? 'Centro Carter · informe final' : 'Carter Center · final report',
  reviewType: es ? 'Evaluación de evidencia · 17 feb 2025' : 'Evidence assessment · Feb 17, 2025',
  reviewFinding: es
    ? 'Revisó las actas recopiladas y publicadas por la oposición. En una muestra aleatoria de 100 mesas no halló diferencias entre las cifras transcritas y las fotografías examinadas.'
    : 'Reviewed opposition-published tally sheets. In a random sample of 100 stations, it found no discrepancies between transcribed data and the photographs examined.',
  link: es ? 'Leer fuente primaria' : 'Read primary source',
  context: es ? 'La explicación oficial y su límite' : 'The official explanation and its limit',
  contextText: es
    ? 'El CNE atribuyó la falta de publicación a un ciberataque. El informe final del Centro Carter señala que no se aportó evidencia de ese ataque ni se publicó el desglose por una vía alternativa. Esa ausencia puede comprobarse; las motivaciones no pueden deducirse solo de ella.'
    : 'The CNE attributed non-publication to a cyberattack. The Carter Center final report says no supporting evidence for the attack was supplied and no alternative release of station-level results followed. That evidentiary gap is documented; motives cannot be inferred from it alone.',
  contextLink: es ? 'Consultar informe final' : 'Read final report'
};
const sources = [
  {
    title: copy.carterTitle, type: copy.carterType, finding: copy.carterFinding,
    href: 'https://www.cartercenter.org/news/venezuela-073024/',
    index: '01'
  },
  {
    title: copy.unTitle, type: copy.unType, finding: copy.unFinding,
    href: 'https://news.un.org/en/sites/news.un.org.en/files/atoms/files/Interim_Report_PoE_Venezuela_090824.pdf',
    index: '02'
  },
  {
    title: copy.reviewTitle, type: copy.reviewType, finding: copy.reviewFinding,
    href: 'https://www.cartercenter.org/publication/final-report-observation-of-the-2024-presidential-election-in-venezuela/',
    index: '03'
  }
];
---

<section id="internacional" class="observer-section">
  <div class="observer-section__container">
    <div class="observer-section__heading">
      <span class="section-label">{copy.kicker}</span>
      <h2>{copy.title}</h2>
      <p>{copy.opening}</p>
    </div>
    <div class="observer-section__grid">
      {sources.map(s => (
        <article class="observer-section__finding">
          <div class="observer-section__index">{s.index} <span>{es ? 'FUENTE' : 'SOURCE'}</span></div>
          <p class="observer-section__kind">{s.type}</p>
          <h3>{s.title}</h3>
          <p class="observer-section__description">{s.finding}</p>
          <a href={s.href} target="_blank" rel="noopener noreferrer">{copy.link} ↗</a>
        </article>
      ))}
    </div>
    <aside class="observer-section__limit">
      <div>
        <strong>{copy.context}</strong>
        <p>{copy.contextText}</p>
      </div>
      <a href="https://www.cartercenter.org/publication/final-report-observation-of-the-2024-presidential-election-in-venezuela/" target="_blank" rel="noopener noreferrer">{copy.contextLink} ↗</a>
    </aside>
  </div>
</section>

<style>
  .observer-section { padding: clamp(3.5rem, 7vw, 6rem) clamp(1rem, 3vw, 2rem); background: color-mix(in srgb, var(--color-brand-600) 3%, var(--bg-body)); }
  .observer-section__container { width: min(1120px, 100%); margin: auto; }
  .observer-section__heading { max-width: 800px; margin-bottom: 2rem; }
  .observer-section__heading h2 { font: 800 clamp(2rem, 3.5vw, 3.2rem) / 1.12 var(--font-display, sans-serif); letter-spacing: -.043em; color: var(--text-primary); margin: .8rem 0 1rem; text-wrap: balance; }
  .observer-section__heading > p { font-size: clamp(1rem, 1.6vw, 1.16rem); line-height: 1.7; color: var(--text-secondary); max-width: 67ch; }
  .observer-section__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .observer-section__finding { border: 1px solid var(--border-subtle); border-top: 3px solid #426e84; background: var(--bg-card); padding: 1.5rem; display: flex; flex-direction: column; min-height: 330px; }
  .observer-section__index { font: 750 1.8rem / 1 var(--font-display, sans-serif); letter-spacing: -.04em; color: #628299; display: flex; align-items: center; gap: .7rem; }
  .observer-section__index span { font: 750 .64rem / 1.4 var(--font-mono, monospace); letter-spacing: .14em; color: var(--text-secondary); }
  .observer-section__kind { font: 650 .76rem / 1.55 var(--font-mono, monospace); color: var(--text-secondary); margin: 1.7rem 0 .45rem; }
  .observer-section__finding h3 { font: 750 1.22rem / 1.3 var(--font-display, sans-serif); color: var(--text-primary); margin: 0 0 .9rem; }
  .observer-section__description { flex: 1; font-size: .95rem; line-height: 1.65; color: var(--text-secondary); }
  .observer-section__finding a { font-size: .85rem; font-weight: 700; color: var(--text-accent); text-underline-offset: .22em; }
  .observer-section__limit { margin-top: 1.25rem; padding: 1.5rem 1.75rem; border-left: 4px solid #b87b3b; background: var(--bg-card); display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center; justify-content: space-between; }
  .observer-section__limit > div { flex: 1 1 30rem; }
  .observer-section__limit strong { font-size: 1.03rem; color: var(--text-primary); }
  .observer-section__limit p { color: var(--text-secondary); line-height: 1.65; margin: .55rem 0 0; font-size: .93rem; }
  .observer-section__limit a { color: var(--text-accent); font-weight: 700; font-size: .85rem; text-underline-offset: .2em; }
  .observer-section a:focus-visible { outline: 3px solid var(--text-accent); outline-offset: 4px; }
  @media (max-width: 850px) { .observer-section__grid { grid-template-columns: 1fr; } .observer-section__finding { min-height: auto; } }
  @media print { .observer-section { background: white; } .observer-section__finding, .observer-section__limit { border: 1px solid #aaa; } }
</style>
