---
import { getLangFromUrl } from '../i18n/utils';
import { EXTERNAL_LINKS } from '../data/site';
import provenance from '../data/acta-provenance.json';

const lang = getLangFromUrl(Astro.url);
const c = provenance.copy[lang === 'en' ? 'en' : 'es'];
---

<section id="procedencia" class="provenance" aria-labelledby="provenance-title">
  <div class="pv-container">
    <div class="pv-folio"><span>{c.eyebrow}</span><span>VENEZUELA / 28 JUL 2024</span></div>
    <header class="pv-intro">
      <h2 id="provenance-title">{c.title}<br /><em>{c.accent}</em></h2>
      <p>{c.intro}</p>
    </header>

    <div class="pv-diagram">
      <div class="pv-diagram__exhibit">
        <div class="pv-exhibit-head">EVIDENCE / 02-A <span>FIG. 01</span></div>
        <div class="pv-paper" aria-hidden="true">
          <span class="pv-paper__head">CNE · 28J</span>
          <strong>ACTA DE ESCRUTINIO</strong>
          <div class="pv-paper__rule"></div><i></i><i></i><i></i>
          <div class="pv-paper__columns"><b></b><b></b><b></b><b></b></div>
          <div class="pv-paper__foot"><span>HASH / QR / SIGN</span><span class="pv-paper__pattern"></span></div>
        </div>
        <p>{c.drawing}</p>
      </div>
      <div class="pv-diagram__text">
        <p class="pv-diagram__principle">{c.visualTag}</p>
        <ol class="pv-steps">
          {c.steps.map((step) => <li><span>{step[0]}</span><div><h3>{step[1]}</h3><p>{step[2]}</p></div></li>)}
        </ol>
        <a href={provenance.process.source.url} target="_blank" rel="noopener noreferrer">{c.sourceProcess} ↗</a>
      </div>
    </div>

    <div class="pv-proof">
      <div class="pv-proof__heading"><span>TRAZABILIDAD / 03 VERIFICACIONES</span><h3>{c.proofTitle}</h3></div>
      <div class="pv-proof__grid">
        {c.checks.map((check, index) => <article><span class="pv-proof__index">0{index + 1} /</span><h4>{check[0]}</h4><p>{check[1]}</p><a href={index === 1 ? provenance.process.source.url : provenance.authenticity.source.url} target="_blank" rel="noopener noreferrer">{c.sourceEvidence} ↗</a></article>)}
      </div>
    </div>

    <div class="pv-videos">
      <div class="pv-videos__intro">
        <span>{c.videoKicker}</span>
        <h3>{c.videoTitle}</h3>
        <p>{c.videoIntro}</p>
        <a href={provenance.video.source.url} target="_blank" rel="noopener noreferrer">{c.videoSource} ↗</a>
      </div>
      <div class="pv-videos__count">
        <div class="pv-videos__major"><strong>{provenance.video.reviewed}</strong><span>{c.reviewedLabel}</span></div>
        <div class="pv-videos__twocol"><div><strong>{provenance.video.exact}</strong><span>{c.exactLabel}</span></div><div><strong>{provenance.video.stations}</strong><span>{c.stationsLabel}</span></div></div>
        <p class="pv-videos__qualification">{c.videoLimit}</p>
      </div>
    </div>
    <aside class="pv-caveat">
      <div><h3>{c.limitTitle}</h3><p>{c.limit}</p></div>
      <div class="pv-caveat__links"><a href={EXTERNAL_LINKS.resultadosConVzla} target="_blank" rel="noopener noreferrer">{c.view} ↗</a><a href="#analisis-tecnico">{c.next} ↓</a></div>
    </aside>
  </div>
</section>

<style>
  .provenance{background:#edeae2;color:#182b3e;padding:clamp(4rem,7vw,7rem) clamp(1rem,3vw,2rem)}
  .pv-container{width:min(1160px,100%);margin:auto}
  .pv-folio{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem;padding:1rem 0;border-block:1px solid #a9b1b0;font:750 .67rem/1.5 var(--font-mono,monospace);letter-spacing:.12em;color:#4e6274}
  .pv-intro{padding:clamp(2.5rem,5vw,5rem) 0 clamp(2.5rem,4vw,4rem)}
  .pv-intro h2{font:800 clamp(2.6rem,5.5vw,5.5rem)/1.04 var(--font-display,sans-serif);letter-spacing:-.06em;max-width:24ch;text-wrap:balance;margin:0 0 1.7rem;color:#172c40}
  .pv-intro h2 em{font-style:normal;color:#9c612c}
  .pv-intro p{font-size:clamp(1.02rem,1.5vw,1.23rem);line-height:1.75;color:#405665;max-width:75ch;margin:0}
  .pv-diagram{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);background:#10273e;box-shadow:0 30px 65px #172f4326}
  .pv-diagram__exhibit{min-width:0;background:#213b53;display:flex;flex-direction:column;align-items:center;padding:clamp(1.5rem,3vw,3rem)}
  .pv-exhibit-head{width:100%;display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid #7a98a266;padding-bottom:1rem;color:#c0d4df;font:700 .66rem var(--font-mono,monospace);letter-spacing:.12em}
  .pv-paper{transform:rotate(-2.5deg);width:min(285px,90%);background:#f9f6ee;color:#213a52;box-shadow:14px 14px 0 #07152677,0 18px 35px #060e1c40;padding:1.6rem;min-height:330px;margin:2.4rem auto 1rem}
  .pv-paper__head{display:block;font:750 .65rem var(--font-mono,monospace);color:#62798c;letter-spacing:.1em}
  .pv-paper strong{display:block;font:800 1rem/1.3 var(--font-display,sans-serif);letter-spacing:-.035em;margin-top:1rem}
  .pv-paper__rule{height:2px;background:#b99253;margin:1rem 0}
  .pv-paper i{display:block;width:80%;height:6px;margin:.75rem 0;background:#d0d7d9}
  .pv-paper i:nth-of-type(2){width:95%}.pv-paper i:nth-of-type(3){width:60%}
  .pv-paper__columns{display:grid;grid-template-columns:1fr 1fr;gap:1rem;border-top:1px solid #c7cfcf;padding-top:1rem;margin-top:1.4rem}
  .pv-paper__columns b{height:6px;background:#d0d7d9}
  .pv-paper__foot{display:flex;justify-content:space-between;align-items:end;border-top:1px solid #c7cfcf;padding-top:.8rem;margin-top:1.4rem;font:650 .58rem var(--font-mono,monospace);color:#61788b}
  .pv-paper__pattern{width:36px;height:36px;background:repeating-conic-gradient(#294962 0 25%,transparent 0 50%) 0 0/9px 9px}
  .pv-diagram__exhibit>p{font-size:.75rem;color:#bdd0da;text-align:center;margin:.5rem 0}
  .pv-diagram__text{padding:clamp(1.5rem,4vw,3.8rem);display:flex;flex-direction:column;min-width:0}
  .pv-diagram__principle{font:800 clamp(1.15rem,2vw,1.65rem)/1.35 var(--font-display,sans-serif);letter-spacing:-.035em;color:#e8bf7e;max-width:23ch;margin:0 0 1.7rem}
  .pv-steps{list-style:none;margin:0;padding:0;flex:1}
  .pv-steps li{display:grid;grid-template-columns:2.6rem 1fr;gap:1rem;padding:1.2rem 0;border-top:1px solid #738c9570}
  .pv-steps li>span{font:800 1.2rem var(--font-mono,monospace);color:#eac37a}
  .pv-steps h3{font:750 1.15rem/1.35 var(--font-display,sans-serif);color:#fff;margin:0 0 .45rem}
  .pv-steps p{font-size:.92rem;color:#bfd0dc;line-height:1.6;margin:0}
  .pv-diagram__text>a{font-size:.84rem;font-weight:750;color:#edc37b;text-underline-offset:4px;margin-top:1.6rem}
  .pv-proof{padding:clamp(3.5rem,6vw,5.5rem) 0}
  .pv-proof__heading{display:grid;grid-template-columns:minmax(0,.35fr) minmax(0,.65fr);gap:1.5rem;margin-bottom:2rem}
  .pv-proof__heading>span{color:#805f34;font:750 .66rem/1.5 var(--font-mono,monospace);letter-spacing:.09em;padding-top:.4rem}
  .pv-proof__heading h3{color:#1d3043;font:800 clamp(1.7rem,3vw,2.9rem)/1.13 var(--font-display,sans-serif);letter-spacing:-.045em;max-width:23ch;margin:0}
  .pv-proof__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-block:1px solid #b1babb}
  .pv-proof__grid article{display:flex;flex-direction:column;min-width:0;padding:1.8rem 1.35rem 1.8rem 0}
  .pv-proof__grid article+article{border-left:1px solid #b1babb;padding-left:1.35rem}
  .pv-proof__index{font:800 .88rem var(--font-mono,monospace);color:#a46b32}
  .pv-proof h4{font:800 1.16rem/1.3 var(--font-display,sans-serif);color:#162a40;letter-spacing:-.02em;margin:1rem 0 .7rem}
  .pv-proof article p{font-size:.91rem;line-height:1.7;color:#495b65;flex:1;margin:0 0 1.5rem}
  .pv-proof article a{font-size:.83rem;color:#21516e;font-weight:800;text-underline-offset:3px}
  .pv-videos{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);background:#fffdf8;border-top:5px solid #bc9762;box-shadow:0 18px 45px #152b3d15}
  .pv-videos__intro{padding:clamp(1.5rem,3.8vw,3.2rem);border-right:1px solid #d6dddf}
  .pv-videos__intro>span{font:800 .68rem var(--font-mono,monospace);letter-spacing:.09em;color:#976b35}
  .pv-videos h3{font:800 clamp(1.7rem,2.8vw,2.6rem)/1.14 var(--font-display,sans-serif);letter-spacing:-.045em;color:#162c41;max-width:19ch;margin:1.5rem 0}
  .pv-videos__intro p{font-size:.95rem;line-height:1.75;color:#465b69;margin:0 0 1.5rem}
  .pv-videos__intro a{color:#1f5373;font-size:.86rem;font-weight:800;text-underline-offset:3px}
  .pv-videos__count{min-width:0;padding:clamp(1.5rem,3vw,2.8rem)}
  .pv-videos__major{display:flex;align-items:center;gap:1.5rem;border-bottom:1px solid #d5dfe1;padding-bottom:1.5rem}
  .pv-videos__major strong{font:800 clamp(4rem,7vw,6rem)/1 var(--font-display,sans-serif);letter-spacing:-.075em;color:#204865}
  .pv-videos__major span{font-size:.95rem;font-weight:700;color:#526575;line-height:1.4}
  .pv-videos__twocol{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:1.5rem 0}
  .pv-videos__twocol div{display:flex;flex-direction:column;gap:.35rem}
  .pv-videos__twocol strong{font:800 clamp(2.5rem,4vw,3.6rem)/1 var(--font-display,sans-serif);color:#995d2f;letter-spacing:-.05em}
  .pv-videos__twocol span{color:#536474;font-size:.83rem;line-height:1.4}
  .pv-videos__qualification{margin:0;border-top:1px solid #d5dfe1;padding-top:1.1rem;font-size:.83rem;color:#4b616e;line-height:1.7}
  .pv-caveat{display:flex;flex-wrap:wrap;gap:1rem 2.5rem;align-items:center;justify-content:space-between;background:#dce2dd;border-left:4px solid #a87c40;padding:clamp(1.4rem,3vw,2.3rem);margin-top:1.4rem}
  .pv-caveat>div:first-child{max-width:72ch;flex:1 1 28rem}
  .pv-caveat h3{font:800 .86rem/1.5 var(--font-mono,monospace);color:#2e4756;margin:0}
  .pv-caveat p{font-size:.88rem;line-height:1.7;color:#465966;margin:.5rem 0 0}
  .pv-caveat__links{display:flex;flex-direction:column;align-items:flex-start;gap:.8rem}
  .pv-caveat__links a{color:#1e5171;font-weight:800;font-size:.84rem;text-underline-offset:3px}
  .provenance a:focus-visible{outline:3px solid #ad7827;outline-offset:3px}
  @media(max-width:860px){.pv-diagram,.pv-videos{grid-template-columns:1fr}.pv-proof__heading{grid-template-columns:1fr}.pv-proof__grid{grid-template-columns:1fr}.pv-proof__grid article,.pv-proof__grid article+article{border-left:0;padding:1.45rem 0}.pv-proof__grid article+article{border-top:1px solid #b1babb}.pv-videos__intro{border-right:0;border-bottom:1px solid #d6dddf}}
  @media(max-width:430px){.pv-intro h2{font-size:clamp(2.05rem,9vw,2.65rem)}.pv-paper{width:min(235px,100%);min-height:310px}.pv-steps li{grid-template-columns:2rem 1fr;gap:.75rem}.pv-videos__major{gap:1rem}}
  @media print{.provenance{background:#fff}.pv-diagram,.pv-videos{box-shadow:none}}
</style>
